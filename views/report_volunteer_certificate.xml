<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_volunteer_certificate" model="ir.actions.report">
        <field name="name">Certificate of Appreciation</field>
        <field name="model">csr.volunteer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">community_service.report_volunteer_certificate_template</field>
        <field name="report_file">community_service.report_volunteer_certificate_template</field>
        <field name="binding_model_id" ref="model_csr_volunteer"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_volunteer_certificate_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                        <div style="position: relative; border: 12px double #1f4e78; padding: 60px; text-align: center; margin-top: 40px; border-radius: 10px; background-color: #fcfcfc;">
                            
                            <img src="/community_service/static/description/aus_logo.png" 
                                 style="position: absolute; top: 40px; left: 40px; max-height: 75px;" 
                                 alt="AUS Logo"/>
                            
                            <img src="/community_service/static/description/icon.jpeg" 
                                 style="position: absolute; top: 40px; right: 40px; max-height: 75px;" 
                                 alt="UniAid Logo"/>

                            <h1 style="font-size: 45px; color: #1f4e78; font-weight: bold; margin-bottom: 10px;">CERTIFICATE</h1>
                            <h2 style="font-size: 28px; color: #4a4a4a; margin-bottom: 40px; letter-spacing: 2px;">OF APPRECIATION</h2>

                            <p style="font-size: 18px; color: #666;">This certificate is proudly presented to</p>
                            
                            <h2 style="font-size: 42px; border-bottom: 2px solid #1f4e78; display: inline-block; padding-bottom: 5px; margin-bottom: 30px; font-family: serif;">
                                <span t-field="o.name"/>
                            </h2>

                            <div style="font-size: 18px; margin-bottom: 30px;">
                                University ID: <strong><span t-field="o.university_id"/></strong><br/>
                                Major: <strong><span t-field="o.major"/></strong>
                            </div>

                            <p style="font-size: 18px; margin-top: 20px; line-height: 1.6; padding: 0 40px;">
                                In recognition of their outstanding dedication and commitment to community service. 
                                By successfully logging <strong><span t-esc="'%.1f' % o.total_hours"/> hours</strong> across UniAid initiatives, 
                                they have made a measurable impact on our community.
                            </p>

                            <div class="row" style="margin-top: 80px;">
                                <div class="col-6 text-center">
                                    <div style="border-top: 2px solid #000; width: 70%; margin: 0 auto; padding-top: 10px;">
                                        <strong>Program Director</strong><br/>
                                        <span style="color: #666; font-size: 14px;">AUS Community Service Department</span>
                                    </div>
                                </div>
                                <div class="col-6 text-center">
                                    <div style="width: 70%; margin: 0 auto; padding-top: 10px;">
                                        <strong style="color: #4a4a4a;">Date of Issue:</strong><br/>
                                        <span style="color: #1f4e78; font-size: 16px; font-weight: bold;">
                                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>